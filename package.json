{
  "name": "better-than-yesterday",
  "private": true,
  "scripts": {
    "prepare:assets": "node scripts/embed-room-assets.cjs",
    "prepare:windows": "node scripts/patch-granite-windows.cjs",
    "predev": "npm run prepare:windows && npm run prepare:assets",
    "dev": "granite dev",
    "prebuild": "npm run prepare:windows && npm run prepare:assets",
    "build": "ait build",
    "release:check": "node scripts/release-check.cjs",
    "release:build": "npm run prepare:assets && npm run release:check && npm run typecheck && npm test -- --runInBand && npm run build",
    "qa:room:visual": "python scripts/render-room-visual-qa.py",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write",
    "deploy": "ait deploy"
  },
  "dependencies": {
    "@apps-in-toss/framework": "^2.10.6",
    "@apps-in-toss/native-modules": "^2.10.6",
    "@granite-js/native": "1.0.36",
    "@granite-js/react-native": "1.0.36",
    "brick-module": "0.5.1",
    "react": "19.2.3",
    "react-native": "0.84.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/runtime": "7.28.4",
    "@biomejs/biome": "^1.9.4",
    "@granite-js/plugin-hermes": "1.0.36",
    "@granite-js/plugin-router": "1.0.36",
    "@testing-library/react-native": "13.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "babel-preset-granite": "1.0.36",
    "jest": "^29.7.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "dependenciesMeta": {
    "hermes-compiler": {
      "unplugged": true
    }
  }
}
